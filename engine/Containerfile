# Builds Duke Nukem 3D on EDuke32 to WebAssembly for the module's engine worker: assets/eduke32.js
# and assets/eduke32.wasm, single-threaded, with no SDL window, events or audio and no DOM. Polymost
# and the classic renderer draw with WebGL 2 on the worker's OffscreenCanvas, through glbuild_ein.cpp,
# a layer that gives them the fixed-function OpenGL they use (matrices, immediate mode, client
# arrays, fog, the alpha test) and merges their draws; the platform layer is einlayer.cpp, the sound
# card driver_ein.cpp, what the worker asks of the game game_ein.cpp.
#
#   docker buildx build --file engine/Containerfile --output type=local,dest=assets engine
#   podman build --file engine/Containerfile --output type=local,dest=assets engine
#
# The local exporter writes the files on the host, so no bind mount needs to be writable.
# Run from the repository's root directory.

# emsdk 6.0.13, the multi-platform index (linux/amd64 and linux/arm64).
FROM docker.io/emscripten/emsdk:6.0.13@sha256:fb7864e398acfda863dfcea78b8bc8adad359fa60c6a0bbeb845931de64aa68a AS build

# DigitalCyberSoft's EDuke32 for WebAssembly, pinned. GPL-2.0-or-later; the engine's BUILD code under
# Ken Silverman's BUILD licence.
ARG EDUKE32_COMMIT=37b56eefaf8125eaa853c417512019cc7ad94b81
RUN git init -q /src \
  && git -C /src fetch -q --depth 1 https://github.com/DigitalCyberSoft/eduke32-wasm.git ${EDUKE32_COMMIT} \
  && git -C /src checkout -q FETCH_HEAD

# Polymost on WebGL 2 through glbuild_ein.cpp and GLSL ES 3.00 shaders (webgl.patch), and the build
# for the engine worker (ein.patch); the files these add are in files/.
COPY webgl.patch ein.patch /
COPY files/ /src/
RUN git -C /src apply /webgl.patch /ein.patch \
  && rm -rf /src/.git \
  && printf 'VC_REV := %s\nVC_HASH := ein\n' "$(echo ${EDUKE32_COMMIT} | cut -c1-9)" > /src/EDUKE32_REVISION.mak

WORKDIR /src
COPY build.sh /
RUN mkdir -p /out \
  && sh /build.sh /out \
  && echo "EDuke32 for WebAssembly (DigitalCyberSoft/eduke32-wasm) ${EDUKE32_COMMIT} with webgl.patch, ein.patch and files/, emsdk 6.0.13" > /out/eduke32-build.txt

FROM scratch
COPY --from=build /out/ /

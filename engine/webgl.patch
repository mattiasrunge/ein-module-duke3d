diff --git a/source/build/src/glbuild.cpp b/source/build/src/glbuild.cpp
index df6d4ba..199fc89 100644
--- a/source/build/src/glbuild.cpp
+++ b/source/build/src/glbuild.cpp
@@ -101,8 +101,48 @@ void buildgl_setDepthFunc(GLenum func)
     inthash_add(&gl.state[0], GL_DEPTH_FUNC, func, 1);
 }
 
+#ifdef __EMSCRIPTEN__
+// The legacy GL emulation applies GL_ALPHA_TEST only to its own fixed-function
+// programs. Polymost's shaders take it as u_alphaRef instead (GL_GREATER only):
+// the reference while the test is on, -1 while it is off.
+static GLfloat em_alphaRef;
+static int em_alphaTest;
+
+static void em_updateAlphaRef(void)
+{
+    static struct { uint32_t program; GLint loc; GLfloat value; } cache[8];
+    uint32_t const program = gl.currentShaderProgramID;
+
+    if (!program)
+        return;
+
+    int i = 0;
+    while (i < ARRAY_SSIZE(cache) && cache[i].program && cache[i].program != program)
+        i++;
+    if (i == ARRAY_SSIZE(cache))
+        i = 0, cache[0].program = 0;
+    if (!cache[i].program)
+    {
+        cache[i].program = program;
+        cache[i].loc = glGetUniformLocation(program, "u_alphaRef");
+        cache[i].value = -2.f;
+    }
+
+    GLfloat const value = em_alphaTest ? em_alphaRef : -1.f;
+    if (cache[i].loc >= 0 && cache[i].value != value)
+    {
+        glUniform1f(cache[i].loc, value);
+        cache[i].value = value;
+    }
+}
+#endif
+
 void buildgl_setAlphaFunc(GLenum func, GLfloat ref)
 {
+#ifdef __EMSCRIPTEN__
+    em_alphaRef = ref;
+    em_updateAlphaRef();
+#endif
     if ((GLenum)inthash_find(&gl.state[0], GL_ALPHA_TEST_FUNC) == func && inthash_find(&gl.state[0], GL_ALPHA_TEST_REF) == *(int32_t *)&ref)
         return;
 
@@ -113,6 +153,13 @@ void buildgl_setAlphaFunc(GLenum func, GLfloat ref)
 
 void buildgl_setEnabled(GLenum key)
 {
+#ifdef __EMSCRIPTEN__
+    if (key == GL_ALPHA_TEST)
+    {
+        em_alphaTest = 1;
+        em_updateAlphaRef();
+    }
+#endif
     if (inthash_find(&gl.state[0], key) == GL_TRUE)
         return;
 
@@ -123,6 +170,13 @@ void buildgl_setEnabled(GLenum key)
 
 void buildgl_setDisabled(GLenum key)
 {
+#ifdef __EMSCRIPTEN__
+    if (key == GL_ALPHA_TEST)
+    {
+        em_alphaTest = 0;
+        em_updateAlphaRef();
+    }
+#endif
     if (inthash_find(&gl.state[0], key) == GL_FALSE)
         return;
 
@@ -135,6 +189,9 @@ void buildgl_useShaderProgram(uint32_t shaderID)
 {
     glUseProgram(shaderID);
     gl.currentShaderProgramID = shaderID;
+#ifdef __EMSCRIPTEN__
+    em_updateAlphaRef();
+#endif
 }
 

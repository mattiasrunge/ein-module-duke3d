+#ifdef EDUKE32_EIN
+// The release a GRP of `size` bytes is, when its size says it: no other the
+// game knows has that size, or those that do the game treats alike.
+static grpinfo_t const * FindGrpInfoBySize(int32_t size)
+{
+    grpinfo_t const *found = nullptr;
+
+    for (grpinfo_t const *grpinfo = listgrps; grpinfo; grpinfo = grpinfo->next)
+    {
+        if (grpinfo->size != size)
+            continue;
+        if (!found)
+            found = grpinfo;
+        else if (grpinfo->game != found->game || grpinfo->dependency != found->dependency || grpinfo->postprocessing != found->postprocessing
+                 || Bstrcmp(grpinfo->scriptname ? grpinfo->scriptname : "", found->scriptname ? found->scriptname : "")
+                 || Bstrcmp(grpinfo->defname ? grpinfo->defname : "", found->defname ? found->defname : "")
+                 || Bstrcmp(grpinfo->rtsname ? grpinfo->rtsname : "", found->rtsname ? found->rtsname : ""))
+            return nullptr;
+    }
+
+    return found;
+}
+#endif

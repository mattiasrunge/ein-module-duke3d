+// Reads a KVX file whole, in one read, and its first mip.
+static int32_t loadkvx(const char *filnam, int32_t *filelen)
+{
+    const buildvfs_kfd fil = kopen4load(filnam, 0);
+    if (fil == buildvfs_kfd_invalid)
+        return -1;
+
+    int32_t const leng = kfilelength(fil);
+    if (leng < 4 + 768)
+    {
+        kclose(fil);
+        return -1;
+    }
+
+    char *const file = (char *)Xmalloc(leng);
+    int32_t const got = kread(fil, file, leng);
+    kclose(fil);
+
+    int32_t mip1leng;
+    Bmemcpy(&mip1leng, file, sizeof(int32_t));
+    mip1leng = B_LITTLE32(mip1leng);
+
+    int32_t const ret = got == leng
+        ? loadkvxmip(&file[4], min(mip1leng, leng - 4 - 768), (uint8_t const *)&file[leng-768])
+        : -1;
+
+    Xfree(file);
+    *filelen = leng;
+
+    return ret;
+}

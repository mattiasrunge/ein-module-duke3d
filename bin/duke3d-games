#!ts
/** duke3d-games — the games in Duke Nukem 3D's games folder and the free one offered, as the Games page and the game's page list them. */
import type { CmdReturn, Command } from '@ein/client';
import type { GameEntry } from '@games/api';
import type { Game } from '@duke3d/api';
import { findGames } from '@duke3d/catalog';
import { GAMES } from '@duke3d/games';

const duke3dGames = async (cmd: Command): CmdReturn => {
  const [only] = cmd.args.filter((arg) => !arg.startsWith('-'));
  const games = await findGames(cmd, only);
  if (cmd.json) await cmd.writeJSON(games satisfies Game[] satisfies GameEntry[]);
  else {
    for (const game of games) {
      if (game.state === 'offered') await cmd.writeLn(`${game.id}  ${game.title}  offered, duke3d-fetch ${game.id}`);
      else await cmd.writeLn(`${game.id}  ${game.title}  ${game.grp}  ${game.files.length} files${game.maps ? `  maps: ${game.maps.join(' ')}` : ''}`);
    }
  }
  return 0;
};

duke3dGames.spec = {
  name: 'duke3d-games',
  effect: 'read' as const,
  description: `List the games in ${GAMES}, each folder with a duke3d*.grp, the shareware episode first; then the free game duke3d-fetch fetches when it is not there yet`,
  args: [{ name: 'folder', type: 'path' as const, optional: true, description: `only the game in this folder of ${GAMES}, as someone who opened a share link to it reads it` }],
  flags: [],
  examples: ['duke3d-games', `duke3d-games ${GAMES}/shareware`],
  returns:
    'One entry per game. An installed one: its id (the folder\'s name), title, state installed, path, detail, cover (its title screen as a PNG data: URL), the GRP it plays, every file in the folder, their size in bytes, and its user maps (the .map files beside the GRP). An offered one: its id, title, state offered, about and download (bytes).',
};

export default duke3dGames;
